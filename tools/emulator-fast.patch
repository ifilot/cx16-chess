+// Compare the optimized idle path with scalar synthesis, including hidden
+// oscillator/noise state that affects sound after channels are enabled again.
+#include <stdio.h>
+#include <stdlib.h>
+#include "../src/vera_psg.c"
+
+static uint32_t seed = 16;
+static uint32_t random_value(void) {
+    seed = seed * 1664525u + 1013904223u;
+    return seed;
+}
+int main(void) {
+    const unsigned sizes[] = {0, 1, 2, 3, 17, 127, 255, 256, 511, 1000};
+    int16_t scalar[2000], fast[2000];
+    struct channel initial[16], expected[16];
+    for (unsigned trial = 0; trial < 300; trial++) {
+        psg_reset();
+        for (unsigned reg = 0; reg < 64; reg++) psg_writereg(reg, random_value() >> 24);
+        psg_render(fast, 100);
+        for (unsigned ch = 0; ch < 16; ch++) psg_writereg(ch * 4 + 2, random_value() & 63);
+        memcpy(initial, channels, sizeof(channels));
+        uint16_t initial_noise = noise_state;
+        unsigned count = sizes[trial % (sizeof(sizes) / sizeof(sizes[0]))];
+        for (unsigned i = 0; i < count; i++) render(&scalar[2 * i], &scalar[2 * i + 1]);
+        memcpy(expected, channels, sizeof(channels));
+        uint16_t expected_noise = noise_state;
+        memcpy(channels, initial, sizeof(channels));
+        noise_state = initial_noise;
+        psg_render(fast, count);
+        if (memcmp(scalar, fast, count * 2 * sizeof(*fast)) ||
+            memcmp(expected, channels, sizeof(channels)) || noise_state != expected_noise) {
+            fprintf(stderr, "idle PSG mismatch: trial %u, samples %u\n", trial, count);
+            return 1;
+        }
+    }
+    puts("300 idle PSG output/state comparisons passed");
+    return 0;
+}
