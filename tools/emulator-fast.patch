 static uint16_t noise_state;
+static uint16_t enabled_channels;
+// Columns of the linear noise-LFSR transforms for 16 * 2^n steps.
+static uint16_t noise_jump[32][16];
+static bool noise_jump_ready;
+
+static uint16_t noise_next(uint16_t value)
+{
+    return (value << 1) | (((value >> 1) ^ (value >> 2) ^
+                           (value >> 4) ^ (value >> 15)) & 1);
+}
+
+static uint16_t noise_apply(const uint16_t transform[16], uint16_t value)
+{
+    uint16_t result = 0;
+    for (unsigned bit = 0; bit < 16; bit++)
+        if (value & (1u << bit)) result ^= transform[bit];
+    return result;
+}
+
+static void noise_advance(unsigned samples)
+{
+    if (!noise_jump_ready) {
+        for (unsigned bit = 0; bit < 16; bit++) {
+            uint16_t value = 1u << bit;
+            for (unsigned i = 0; i < 16; i++) value = noise_next(value);
+            noise_jump[0][bit] = value;
+        }
+        for (unsigned power = 1; power < 32; power++)
+            for (unsigned bit = 0; bit < 16; bit++)
+                noise_jump[power][bit] = noise_apply(noise_jump[power - 1],
+                                                    noise_jump[power - 1][bit]);
+        noise_jump_ready = true;
+    }
+    for (unsigned power = 0; samples; power++, samples >>= 1)
+        if (samples & 1) noise_state = noise_apply(noise_jump[power], noise_state);
+}
 
